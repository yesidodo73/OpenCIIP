{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yesidodo73/OpenCIIP/main/schemas/binding-layer.schema.json",
  "title": "OpenCIIP Binding Layer",
  "description": "OpenCIIP 플랫폼별 규칙 바인딩 계층 형식입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "priority",
    "selector",
    "bindings"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/canonicalNonBlankString"
    },
    "priority": {
      "type": "integer",
      "minimum": 0
    },
    "selector": {
      "$ref": "#/$defs/platformSelector"
    },
    "scan_support": {
      "type": "string",
      "enum": [
        "unsupported",
        "supported",
        "tested"
      ]
    },
    "platform_verification": {
      "$ref": "#/$defs/verification"
    },
    "defaults": {
      "$ref": "#/$defs/bindingDefaults"
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ruleBinding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "platform_verification"
        ]
      },
      "then": {
        "properties": {
          "selector": {
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/canonicalNonBlankString"
              },
              "version": {
                "$ref": "#/$defs/canonicalNonBlankString"
              },
              "version_major": {
                "const": ""
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scan_support": {
            "const": "tested"
          }
        },
        "required": [
          "scan_support"
        ]
      },
      "then": {
        "properties": {
          "selector": {
            "required": [
              "id",
              "version",
              "architecture"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "canonicalNonBlankString": {
      "type": "string",
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "verificationEnvironment": {
      "type": "string",
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "selectorString": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/canonicalNonBlankString"
        }
      ]
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "platformSelector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "$ref": "#/$defs/selectorString"
        },
        "family": {
          "$ref": "#/$defs/selectorString"
        },
        "id": {
          "$ref": "#/$defs/selectorString"
        },
        "version": {
          "$ref": "#/$defs/selectorString"
        },
        "version_major": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          ]
        },
        "architecture": {
          "$ref": "#/$defs/selectorString"
        }
      },
      "anyOf": [
        {
          "required": [
            "os"
          ],
          "properties": {
            "os": {
              "$ref": "#/$defs/canonicalNonBlankString"
            }
          }
        },
        {
          "required": [
            "family"
          ],
          "properties": {
            "family": {
              "$ref": "#/$defs/canonicalNonBlankString"
            }
          }
        },
        {
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/canonicalNonBlankString"
            }
          }
        },
        {
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/canonicalNonBlankString"
            }
          }
        },
        {
          "required": [
            "version_major"
          ],
          "properties": {
            "version_major": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        {
          "required": [
            "architecture"
          ],
          "properties": {
            "architecture": {
              "$ref": "#/$defs/canonicalNonBlankString"
            }
          }
        }
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "rejected"
          ]
        },
        "environments": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/verificationEnvironment"
          }
        },
        "verified_at": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "verified"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "environments",
              "verified_at"
            ],
            "properties": {
              "environments": {
                "minItems": 1
              },
              "verified_at": {
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "verified_at": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "bindingDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicable": {
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "ruleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^U-[0-9]{2}$"
        },
        "evaluator": {
          "type": "string",
          "pattern": "\\S"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "applicable": {
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    }
  }
}
